# WraithWatch environment configuration
# Copy this file to `.env` and fill in your values.

# ── Database ──────────────────────────────────────────────
# Development (default): SQLite — no setup needed, leave blank.
# Production (Week 9):   PostgreSQL — uncomment and fill in.
#
# DATABASE_URL=postgresql://wraithwatch_user:your_password@localhost:5432/wraithwatch

# ── AbuseIPDB API key (optional) ──────────────────────────
# Sign up free at https://www.abuseipdb.com/api (1000 checks/day)
# Without this, IP reputation scores show as blank.
ABUSEIPDB_API_KEY=

# ── Security ──────────────────────────────────────────────
# Change this to a long random string in production.
SECRET_KEY=dev-secret-key-change-in-production

# ── Tuning ────────────────────────────────────────────────
# Minutes before a log source is considered "stale".
STALE_SOURCE_MINUTES=5

# Folder where uploaded log files are stored.
LOG_UPLOAD_FOLDER=uploads
